# ─── Penpact API — environment template ───
# Copy to .env and fill in. NEVER commit .env.

# Runtime
NODE_ENV=development
PORT=3000

# Postgres (Drizzle)
DATABASE_URL=postgres://penpact:penpact@localhost:5432/penpact

# Object storage for documents (Cloudflare R2 / S3-compatible) — immutable retention
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=penpact-documents
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# AI field auto-detection (Claude API). Unset → auto-detect returns no fields.
ANTHROPIC_API_KEY=
PENPACT_AI_MODEL=claude-opus-4-8

# PAdES signing. Unset → a per-process self-signed cert (valid but untrusted chain).
# Provide a base64-encoded PKCS#12 (.p12) for a CA-issued, trusted signature.
PENPACT_SIGNING_P12_BASE64=
PENPACT_SIGNING_P12_PASSPHRASE=

# Webhooks (best-effort). Unset → no delivery.
WEBHOOK_URL=
WEBHOOK_SECRET=

# Public base URL (used to build signing links)
PUBLIC_BASE_URL=http://localhost:3000
