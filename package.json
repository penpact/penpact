{
  "name": "penpact",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source, embeddable e-signature API — the developer-first, open DocuSign alternative.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "typecheck": "tsc -b --verbose",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@penpact/api": "workspace:*",
    "@penpact/core": "workspace:*",
    "@penpact/db": "workspace:*",
    "@penpact/sdk": "workspace:*",
    "drizzle-orm": "^0.38.0",
    "pdf-lib": "^1.17.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
