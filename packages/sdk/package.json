{
  "name": "@penpact/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript SDK for the Penpact e-signature API — the open, embeddable DocuSign alternative.",
  "license": "AGPL-3.0-only",
  "homepage": "https://penpact.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/penpact/penpact.git",
    "directory": "packages/sdk"
  },
  "bugs": "https://github.com/penpact/penpact/issues",
  "keywords": [
    "e-signature",
    "esignature",
    "electronic-signature",
    "docusign-alternative",
    "pdf",
    "signing",
    "penpact"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch"
  }
}
