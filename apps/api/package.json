{
  "name": "@penpact/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schemas": {
      "import": "./dist/schemas.js",
      "default": "./dist/schemas.js"
    },
    "./crypto": {
      "import": "./dist/lib/crypto.js",
      "default": "./dist/lib/crypto.js"
    },
    "./storage": {
      "import": "./dist/storage/index.js",
      "default": "./dist/storage/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@hono/zod-validator": "^0.4.0",
    "@penpact/core": "workspace:*",
    "@penpact/db": "workspace:*",
    "drizzle-orm": "^0.38.0",
    "hono": "^4.6.0",
    "pdf-lib": "^1.17.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0"
  }
}
