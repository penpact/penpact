{
  "name": "@penpact/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schemas": {
      "import": "./dist/schemas.js",
      "default": "./dist/schemas.js"
    },
    "./crypto": {
      "import": "./dist/lib/crypto.js",
      "default": "./dist/lib/crypto.js"
    },
    "./storage": {
      "import": "./dist/storage/index.js",
      "default": "./dist/storage/index.js"
    },
    "./webhooks": {
      "import": "./dist/services/webhooks.js",
      "default": "./dist/services/webhooks.js"
    },
    "./keys": {
      "import": "./dist/services/keys.js",
      "default": "./dist/services/keys.js"
    },
    "./ai-fields": {
      "import": "./dist/services/ai-fields.js",
      "default": "./dist/services/ai-fields.js"
    },
    "./pades": {
      "import": "./dist/services/pades.js",
      "default": "./dist/services/pades.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "bootstrap": "tsx src/bin/bootstrap.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@hono/node-server": "^1.13.0",
    "@hono/zod-validator": "^0.4.0",
    "@penpact/core": "workspace:*",
    "@penpact/db": "workspace:*",
    "@signpdf/placeholder-pdf-lib": "^3.3.0",
    "@signpdf/signer-p12": "^3.3.0",
    "@signpdf/signpdf": "^3.3.0",
    "drizzle-orm": "^0.38.0",
    "hono": "^4.6.0",
    "node-forge": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/node-forge": "^1.3.0",
    "tsx": "^4.19.0"
  }
}
