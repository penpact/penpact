---
export interface Props {
  title: string;
  description: string;
  /** Path-only canonical, e.g. "/penpact-vs-docusign". Defaults to current URL. */
  path?: string;
  article?: boolean;
}

const { title, description, path, article = false } = Astro.props;
const canonical = new URL(path ?? Astro.url.pathname, Astro.site).toString();
const ogImage = new URL('/og.svg', Astro.site).toString();
const year = 2026;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Penpact" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'Penpact',
      url: 'https://penpact.dev',
      logo: 'https://penpact.dev/favicon.svg',
      sameAs: ['https://github.com/penpact/penpact'],
    })} />

    <style is:global>
      :root {
        --bg: #0b0c10; --panel: #14161d; --line: #262a35; --ink: #e8eaf0;
        --muted: #9aa3b2; --brand: #5b8cff; --brand-2: #7aa2ff; --ok: #3fb37f;
        --code-bg: #11131a; --radius: 12px; --maxw: 1080px;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0; background: var(--bg); color: var(--ink);
        font: 16px/1.65 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
          Helvetica, Arial, sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      a { color: var(--brand-2); text-decoration: none; }
      a:hover { text-decoration: underline; }
      .wrap { max-width: var(--maxw); margin: 0 auto; padding: 0 22px; }
      code, pre { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
      pre {
        background: var(--code-bg); border: 1px solid var(--line);
        border-radius: var(--radius); padding: 16px 18px; overflow-x: auto;
        font-size: 14px; line-height: 1.55;
      }
      :not(pre) > code {
        background: var(--code-bg); border: 1px solid var(--line);
        border-radius: 6px; padding: 1px 6px; font-size: 0.9em;
      }
      header.nav {
        position: sticky; top: 0; z-index: 10;
        background: color-mix(in srgb, var(--bg) 88%, transparent);
        backdrop-filter: blur(8px); border-bottom: 1px solid var(--line);
      }
      .nav .row { display: flex; align-items: center; gap: 22px; height: 60px; }
      .brand { font-weight: 700; letter-spacing: -0.02em; font-size: 18px; color: var(--ink); }
      .brand span { color: var(--brand); }
      .nav nav { display: flex; gap: 20px; margin-left: auto; font-size: 14.5px; }
      .nav nav a { color: var(--muted); }
      .nav nav a:hover { color: var(--ink); text-decoration: none; }
      .btn {
        display: inline-block; border-radius: 9px; padding: 10px 16px;
        font-weight: 600; font-size: 14.5px; border: 1px solid var(--line);
      }
      .btn-primary { background: var(--brand); color: #fff; border-color: var(--brand); }
      .btn-primary:hover { background: var(--brand-2); text-decoration: none; }
      .btn-ghost { color: var(--ink); }
      .btn-ghost:hover { border-color: var(--muted); text-decoration: none; }
      footer.site {
        border-top: 1px solid var(--line); margin-top: 80px; padding: 36px 0;
        color: var(--muted); font-size: 14px;
      }
      footer.site .row { display: flex; flex-wrap: wrap; gap: 18px 28px; align-items: center; }
      footer.site a { color: var(--muted); }
      footer.site .spacer { margin-left: auto; }
      @media (max-width: 640px) {
        .nav nav a.hide-sm { display: none; }
      }
    </style>
  </head>
  <body>
    <header class="nav">
      <div class="wrap row">
        <a class="brand" href="/">Pen<span>pact</span></a>
        <nav>
          <a class="hide-sm" href="/open-source-docusign-alternative">Why Penpact</a>
          <a class="hide-sm" href="/penpact-vs-docusign">vs DocuSign</a>
          <a class="hide-sm" href="/embed-e-signatures-nextjs">Docs</a>
          <a href="https://github.com/penpact/penpact">GitHub</a>
          <a href="https://api.penpact.dev/app">Dashboard</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site">
      <div class="wrap row">
        <span>Penpact, open-source e-signature API. AGPL-3.0.</span>
        <a href="https://github.com/penpact/penpact">GitHub</a>
        <a href="/penpact-vs-docusign">vs DocuSign</a>
        <a href="mailto:hello@penpact.dev">hello@penpact.dev</a>
        <span class="spacer">&copy; {year} Penpact</span>
      </div>
    </footer>
  </body>
</html>
