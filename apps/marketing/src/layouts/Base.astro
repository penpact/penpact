---
export interface Props {
  title: string;
  description: string;
  /** Path-only canonical, e.g. "/penpact-vs-docusign". Defaults to current URL. */
  path?: string;
  article?: boolean;
}

const { title, description, path, article = false } = Astro.props;
const canonical = new URL(path ?? Astro.url.pathname, Astro.site).toString();
const ogImage = new URL('/og.svg', Astro.site).toString();
const year = 2026;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0a0b0e" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700;800&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Penpact" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'Penpact',
      url: 'https://penpact.dev',
      logo: 'https://penpact.dev/favicon.svg',
      sameAs: ['https://github.com/penpact/penpact'],
    })} />

    <style is:global>
      :root {
        --bg: #0a0b0e;
        --bg-2: #0c0e13;
        --panel: #13151c;
        --panel-2: #181b23;
        --line: #21242d;
        --line-2: #2c303b;
        --ink: #edeff5;
        --muted: #9298a6;
        --muted-2: #6b7180;
        --brand: #5b8cff;
        --brand-2: #93b3ff;
        --brand-ink: #ffffff;
        --seal: #46cb8b;
        --radius: 14px;
        --radius-lg: 20px;
        --maxw: 1120px;
        --serif: "Instrument Serif", Georgia, "Times New Roman", serif;
        --sans: "Hanken Grotesk", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        --mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
      body {
        margin: 0;
        color: var(--ink);
        font-family: var(--sans);
        font-size: 16px;
        line-height: 1.6;
        letter-spacing: -0.005em;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
        background-color: var(--bg);
        /* soft brand glow at the top + a very faint dot grid for texture */
        background-image:
          radial-gradient(900px 520px at 50% -8%, rgba(91, 140, 255, 0.16), transparent 70%),
          radial-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px);
        background-size: 100% 100%, 26px 26px;
        background-attachment: fixed, fixed;
        background-position: center top, center top;
      }
      ::selection { background: rgba(91, 140, 255, 0.3); color: #fff; }
      a { color: var(--brand-2); text-decoration: none; }
      a:hover { text-decoration: underline; }
      h1, h2, h3 { font-weight: 700; letter-spacing: -0.025em; }
      .wrap { max-width: var(--maxw); margin: 0 auto; padding: 0 24px; }
      .display { font-family: var(--serif); font-weight: 400; letter-spacing: -0.01em; }

      code, pre, kbd { font-family: var(--mono); }
      /* Astro/Shiki code blocks */
      pre.astro-code, pre {
        background: var(--bg-2) !important;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 18px 20px;
        overflow-x: auto;
        font-size: 13.5px;
        line-height: 1.7;
        tab-size: 2;
      }
      :not(pre) > code {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid var(--line);
        border-radius: 6px;
        padding: 1px 6px;
        font-size: 0.88em;
        color: var(--brand-2);
      }

      header.nav {
        position: sticky; top: 0; z-index: 30;
        background: color-mix(in srgb, var(--bg) 72%, transparent);
        backdrop-filter: saturate(150%) blur(14px);
        -webkit-backdrop-filter: saturate(150%) blur(14px);
        border-bottom: 1px solid var(--line);
      }
      .nav .row { display: flex; align-items: center; gap: 24px; height: 64px; }
      .brand {
        display: inline-flex; align-items: center; gap: 9px;
        font-weight: 800; letter-spacing: -0.03em; font-size: 18px; color: var(--ink);
      }
      .brand:hover { text-decoration: none; }
      .brand .mark {
        width: 22px; height: 22px; border-radius: 7px;
        background: linear-gradient(145deg, var(--brand), #3f6fe0);
        box-shadow: 0 4px 14px rgba(91, 140, 255, 0.35), inset 0 1px 0 rgba(255,255,255,0.35);
        display: grid; place-items: center; color: #fff; font-size: 13px;
      }
      .brand b { color: var(--brand-2); font-weight: 800; }
      .nav nav { display: flex; align-items: center; gap: 22px; margin-left: auto; font-size: 14.5px; }
      .nav nav a { color: var(--muted); transition: color 0.15s ease; }
      .nav nav a:hover { color: var(--ink); text-decoration: none; }

      .btn {
        display: inline-flex; align-items: center; gap: 8px;
        border-radius: 11px; padding: 11px 18px;
        font-family: var(--sans); font-weight: 600; font-size: 14.5px;
        border: 1px solid var(--line-2); color: var(--ink);
        transition: transform 0.12s ease, border-color 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
        cursor: pointer;
      }
      .btn:hover { text-decoration: none; transform: translateY(-1px); }
      .btn-primary {
        background: linear-gradient(180deg, var(--brand), #4b78ec);
        color: var(--brand-ink); border-color: transparent;
        box-shadow: 0 8px 24px -8px rgba(91, 140, 255, 0.6), inset 0 1px 0 rgba(255,255,255,0.25);
      }
      .btn-primary:hover { box-shadow: 0 12px 30px -8px rgba(91, 140, 255, 0.75); }
      .btn-ghost { background: rgba(255,255,255,0.02); }
      .btn-ghost:hover { border-color: var(--muted-2); background: rgba(255,255,255,0.05); }

      footer.site {
        border-top: 1px solid var(--line); margin-top: 110px; padding: 44px 0;
        color: var(--muted); font-size: 14px;
      }
      footer.site .row { display: flex; flex-wrap: wrap; gap: 16px 28px; align-items: center; }
      footer.site a { color: var(--muted); }
      footer.site a:hover { color: var(--ink); }
      footer.site .spacer { margin-left: auto; }

      @media (max-width: 680px) {
        .nav nav a.hide-sm { display: none; }
        .nav nav { gap: 16px; }
      }
      @media (prefers-reduced-motion: reduce) {
        * { animation: none !important; transition: none !important; }
      }
    </style>
  </head>
  <body>
    <header class="nav">
      <div class="wrap row">
        <a class="brand" href="/"><span class="mark">P</span>Pen<b>pact</b></a>
        <nav>
          <a class="hide-sm" href="/open-source-docusign-alternative">Why Penpact</a>
          <a href="/pricing">Pricing</a>
          <a class="hide-sm" href="/e-signature-api">Docs</a>
          <a class="hide-sm" href="/blog">Blog</a>
          <a href="https://github.com/penpact/penpact">GitHub</a>
          <a class="btn btn-ghost" href="https://api.penpact.dev/app" style="padding:7px 14px">Dashboard</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site">
      <div class="wrap row">
        <a class="brand" href="/" style="font-size:16px"><span class="mark" style="width:18px;height:18px;font-size:11px">P</span>Pen<b>pact</b></a>
        <span>Open-source e-signature API. AGPL-3.0.</span>
        <a href="https://github.com/penpact/penpact">GitHub</a>
        <a href="/pricing">Pricing</a>
        <a href="/e-signature-api">Docs</a>
        <a href="/blog">Blog</a>
        <a href="/open-source-docusign-alternative">Compare</a>
        <a href="mailto:hello@penpact.dev">hello@penpact.dev</a>
        <span class="spacer">&copy; {year} Penpact</span>
      </div>
    </footer>
  </body>
</html>
